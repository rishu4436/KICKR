{
  "name": "kickr",
  "version": "0.1.0",
  "private": true,
  "description": "KICKR Phase 9: independent result attestation boundary. No mainnet mint. RUN_SETTLEMENT is granted to nobody. Program is USDC authority. Backend does not sign attestations in production.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx api/main.ts",
    "start": "node dist/api/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "db:migrate": "tsx db/migrate-cli.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "dev:seed-free-ux": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/dev-seed-free-ux.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "hono": "^4.13.12",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
