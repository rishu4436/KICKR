# Local placeholders only. Do not put production secrets here.
# Copy to .env for local development. .env is gitignored.
# There is intentionally no escrow signer, private key, or seed phrase.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Authoritative Postgres (local docker-compose default).
DATABASE_URL=postgres://kickr:kickr@localhost:5432/kickr

# Non-authoritative cache. Never authoritative for money.
REDIS_URL=redis://localhost:6379

# Host bound into the signed login message. Not a URL.
AUTH_DOMAIN=localhost

# Infrastructure defaults, not a contest rate-limit policy.
NONCE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Solana placeholders. The RPC URL is server-side only because RPC URLs
# often embed credentials. Phase 1 does not call Solana RPC.
# Do not put a key that can move USDC in this file. No such key exists.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public program id. Not a secret. Not a mint.
ESCROW_PROGRAM_ID=DpmpV74AC91sbHtjRV8VWfBjaAdM143Jub47eG5nEGQN
# Leave blank or set a devnet mint you created. Never the mainnet USDC mint.
USDC_MINT=
USDC_DECIMALS=6

# Sports catalog. local-dev is fictional development data, not a live feed.
SPORTS_DATA_PROVIDER=local-dev
# local-dev is a deterministic development catalog, not a live feed.
# Use unset to start with an empty catalog.

# Live sports adapter (Sportmonks Football API v3). Leave key blank to fail closed.
# Never commit a real API key. LIVE_PROVIDER_CONFIGURED is false without SPORTS_API_KEY.
SPORTS_PROVIDER=none
SPORTS_API_KEY=
SPORTS_API_URL=https://api.sportmonks.com/v3
SPORTS_POLL_INTERVAL=15
SPORTS_REQUEST_TIMEOUT_MS=8000

# Integer squad-credit cap. Not USDC.
# TODO: 100 is a development default, not a confirmed production cap.
FANTASY_CREDIT_CAP=100
# Leave blank. TODO: a numeric max from one club is unspecified.
# Dev rules only require players from both clubs.
FANTASY_MAX_PLAYERS_FROM_ONE_TEAM=

# Join quote lifetime. Not a payment timeout.
RESERVATION_TTL_SECONDS=600
# Leave blank. TODO: per-match entry cap, per-contest extra cap, and USDC exposure cap are unspecified.
# Duplicate wallet in one contest is still rejected. Amounts, if set later, are integer USDC base units.
MAX_ENTRIES_PER_MATCH=
MAX_ENTRIES_PER_CONTEST=
MAX_EXPOSURE_PER_MATCH=

# Phase 9 independent result attestation.
# Format: ID:hexPublicKey,ID2:hexPublicKey. LOCAL_DEV is for tests/dev only — refused in production.
# Leave blank in development (gate still fails closed without an attestation). Production must set a non-LOCAL_DEV attestor.
# Never put attestor private keys here. The backend does not sign attestations in production.
APPROVED_ATTESTORS=
